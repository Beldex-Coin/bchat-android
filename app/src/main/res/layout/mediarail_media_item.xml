<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:layout_marginEnd="4dp"
    android:animateLayoutChanges="true">

    <include layout="@layout/thumbnail_view"
        android:id="@+id/rail_item_image"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        app:thumbnail_radius="0dp"/>

    <ImageView
        android:id="@+id/rail_item_outline"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/editor_rail_selected"
        android:visibility="gone"
        tools:visibility="visible"/>

    <ImageView
        android:id="@+id/rail_item_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="2dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_caption_28"
        android:visibility="gone"
        tools:visibility="visible"/>

    <FrameLayout
        android:id="@+id/rail_item_delete"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@color/editor_rail_remove_background"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_editor_remove" />

    </FrameLayout>

</FrameLayout>
