<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/action_bar_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/page_background"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginHorizontal="30dp"
            android:fontFamily="@font/open_sans_semi_bold"
            android:text="@string/display_name_screen_title_content"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/large_spacing"
            android:layout_marginHorizontal="@dimen/large_spacing"
            android:layout_marginTop="@dimen/large_spacing"
            android:layout_marginEnd="@dimen/large_spacing"
            app:cardBackgroundColor="@color/card_color"
            app:cardCornerRadius="10dp">

            <EditText
                android:id="@+id/displayNameEditText"
                style="@style/SeedBchatEditText"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:hint="@string/enter_name"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:singleLine="true" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="@dimen/medium_spacing"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/open_sans_medium"
            android:text="@string/activity_display_name_hint"
            android:textColor="@color/text_hint"
            android:textAlignment="textStart"
            android:textSize="@dimen/small_font_size" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <!-- Bottom container for WindowInsets -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/registerButton"
                style="@style/Widget.Bchat.Button.Common.Disabled"
                android:layout_width="match_parent"
                android:layout_height="@dimen/medium_button_height"
                android:layout_marginHorizontal="@dimen/medium_spacing"
                android:gravity="center"
                android:text="@string/continue_2"
                android:textAlignment="center" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>