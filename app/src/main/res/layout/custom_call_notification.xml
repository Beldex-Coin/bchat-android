<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/transparent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/image"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="recipient_profile"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/icon_tint"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Title" />

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/version_color"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Subtitle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hangUpButton"
                style="@style/Widget.Bchat.Button.Common.ProminentFilled_DeclineCall"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:textSize="12sp"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Hang Up"
                tools:ignore="NestedWeights" />

            <Button
                android:id="@+id/answerButton"
                style="@style/Widget.Bchat.Button.Common.ProminentFilled_AnswerCall"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:textSize="12sp"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Answer" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
