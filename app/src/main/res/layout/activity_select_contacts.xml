<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/default_bchat_background"
    android:layout_height="match_parent">

    <!-- Figma 7546:14654 header: 46dp bar, thin back arrow, "Add Members" title. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_edit_group_toolbar"
        android:minHeight="46dp"
        android:theme="@style/ThemeOverlay.Bchat.EditGroupToolbar"
        app:maxButtonHeight="46dp"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:elevation="0dp">

        <TextView
            android:id="@+id/selectContactsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/open_sans_regular"
            android:includeFontPadding="false"
            android:text="@string/activity_edit_closed_group_add_members"
            android:textColor="@color/disappear_icon_color"
            android:textSize="16sp" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/addButtonLayout"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/addMemberListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bordered_card_background"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="13dp"
                android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/searchCardView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/search_edit_text_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search_contact"
                    app:tint="@color/chat_input_hint" />

                <EditText
                    android:id="@+id/searchContact"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/open_sans_regular"
                    android:gravity="center_vertical"
                    android:hint="@string/search_contact"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/disappear_icon_color"
                    android:textColorHint="@color/chat_input_hint"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/searchAndClearImageview"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/search_contact"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/view_user"/>

            <LinearLayout
                android:id="@+id/noContactFoundContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="360dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

        <ImageView
            android:id="@+id/icNoContactFound"
            android:layout_width="202dp"
            android:layout_height="81dp"
            android:contentDescription="@string/no_records_found"
            android:src="@drawable/ic_no_contact_found" />

        <TextView
            android:id="@+id/noContactFoundText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/roboto_mono"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/no_contacts_yet"
            android:textColor="@color/contact_card_action_text"
            android:textSize="13.5sp" />

    </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/addButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_add_member_bottom_bar"
        android:paddingHorizontal="21dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp">

        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_edit_group_apply"
            android:enabled="false"
            android:fontFamily="@font/roboto_mono"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/add"
            android:textAllCaps="false"
            android:textColor="@color/chat_input_hint"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>