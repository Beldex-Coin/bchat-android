<?xml version="1.0" encoding="utf-8"?>
<!-- Revamp_2026 message menu row: Roboto Mono label, trailing icon (Figma chat "More option"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="9dp"
    android:paddingEnd="20dp"
    android:paddingBottom="9dp">

    <TextView
        android:id="@+id/context_menu_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/roboto_mono"
        android:textColor="@color/disappear_icon_color"
        android:textSize="14sp"
        tools:text="Archive" />

    <ImageView
        android:id="@+id/context_menu_item_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="22dp"
        android:scaleType="centerInside"
        tools:src="@drawable/ic_message" />

</LinearLayout>
