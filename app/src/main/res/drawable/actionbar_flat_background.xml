<?xml version="1.0" encoding="utf-8"?>
<!-- Revamp_2026 header: #0B0B0B with a #222222 hairline at the bottom (Figma top bars). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0B0B" />
        </shape>
    </item>
    <item android:top="-1dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#222222" />
        </shape>
    </item>
</layer-list>
