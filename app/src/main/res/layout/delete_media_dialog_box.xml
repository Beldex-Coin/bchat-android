<?xml version="1.0" encoding="utf-8"?>
<io.beldex.bchat.components.DeleteMediaPopupView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="18dp"
    android:paddingEnd="15dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/deleteMediaIconTile"
            android:layout_width="58dp"
            android:layout_height="58dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_delete_all" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="13dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/deleteMediaTitleTextview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_bold"
                android:text="@string/delete_item"
                android:textColor="@color/disappear_icon_color"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/deleteMediaDescriptionTextview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/roboto_mono"
                android:lineSpacingExtra="2dp"
                android:text="@string/delete_item_description"
                android:textColor="@color/disappear_icon_color"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelMediaDialogBoxButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_mono"
            android:letterSpacing="0"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/contact_card_action_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/deleteMediaDialogBoxButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/roboto_mono"
            android:letterSpacing="0"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/delete"
            android:textAllCaps="false"
            android:textColor="@color/disappear_icon_color"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</io.beldex.bchat.components.DeleteMediaPopupView>
