<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item
                android:bottom="1dp"
                android:left="2dp"
                android:right="2dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/editor_tool_active_background" />
                </shape>
            </item>
            <item
                android:width="16dp"
                android:height="2dp"
                android:gravity="bottom|center_horizontal">
                <shape android:shape="rectangle">
                    <solid android:color="@color/rounded_indicator" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
