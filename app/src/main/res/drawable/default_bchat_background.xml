<?xml version="1.0" encoding="utf-8"?>
<!-- Revamp_2026 dark window background: #0B0B0B base, radial vignette, faint dot grid (Figma App_lock frame fills). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0B0B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.435"
                android:endColor="#FF000000"
                android:gradientRadius="85%p"
                android:startColor="#991A1A1A"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/bg_dot_tile"
            android:tileMode="repeat" />
    </item>
</layer-list>
