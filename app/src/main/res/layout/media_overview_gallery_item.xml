<?xml version="1.0" encoding="utf-8"?>
<io.beldex.bchat.components.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_overview_tab_selected"
    android:layout_margin="6dp"
    android:padding="0dp">

    <include layout="@layout/thumbnail_view"
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/media_preview_activity__media_content_description" />

    <FrameLayout
        android:id="@+id/selected_indicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/media_overview_selected_border"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_media_checkbox_on" />
    </FrameLayout>

</io.beldex.bchat.components.SquareFrameLayout>
