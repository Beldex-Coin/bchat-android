<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EBEBEB" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.435"
                android:endColor="#00F0F0F0"
                android:gradientRadius="85%p"
                android:startColor="#99FFFFFF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/bg_dot_tile"
            android:tileMode="repeat"
            android:tint="#8D8D8D" />
    </item>
</layer-list>
