<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/editor_tool_active_background" />
            <stroke
                android:width="0.5dp"
                android:color="@color/rounded_indicator" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/editor_chip_background" />
            <stroke
                android:width="0.5dp"
                android:color="@color/attachment_tray_border" />
        </shape>
    </item>
</selector>
