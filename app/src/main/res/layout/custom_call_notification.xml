<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/call_banner_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/image"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="recipient_profile"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:id="@+id/avatarBadge"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_call_banner_avatar_badge" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_semi_bold"
            android:maxLines="1"
            android:textColor="@color/disappear_icon_color"
            android:textSize="14sp"
            tools:text="Person" />

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_regular"
            android:maxLines="1"
            android:textColor="@color/contact_card_action_text"
            android:textSize="10sp"
            tools:text="Incoming voice call.." />
    </LinearLayout>

    <Button
        android:id="@+id/hangUpButton"
        android:layout_width="71dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/call_notification_hangup_background"
        android:ellipsize="end"
        android:fontFamily="@font/open_sans_semi_bold"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:textAllCaps="false"
        android:textColor="#FF3E3E"
        android:textSize="11sp"
        tools:text="Hangup" />

    <Button
        android:id="@+id/answerButton"
        android:layout_width="71dp"
        android:layout_height="32dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/call_notification_answer_background"
        android:ellipsize="end"
        android:fontFamily="@font/open_sans_semi_bold"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:textAllCaps="false"
        android:textColor="@color/home_row_timestamp_unread"
        android:textSize="11sp"
        tools:text="Answer" />

    <!-- In call: running timer + end button (Figma 7546:20387) -->
    <Chronometer
        android:id="@+id/callTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/open_sans_semi_bold"
        android:textColor="@color/contact_card_action_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/endCallButton"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/hang_up"
        android:src="@drawable/ic_call_banner_end_figma"
        android:visibility="gone" />

</LinearLayout>
