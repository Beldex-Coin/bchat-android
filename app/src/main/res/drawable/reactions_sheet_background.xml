<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Reactions" sheet: flat #0B0B0B with a #333 hairline on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_screen_background" />
        </shape>
    </item>
    <item android:bottom="-1dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/recording_bar_border" />
        </shape>
    </item>
</layer-list>
