<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="15dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/video_controls_card"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/video_preview_controls_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="15dp">

        <ImageView
            android:id="@+id/video_play_pause"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/audio_view__play_accessibility_description"
            android:src="@drawable/ic_preview_play_small" />

        <TextView
            android:id="@+id/video_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:fontFamily="@font/roboto_mono"
            android:textColor="@color/reaction_overlay_card_border"
            android:textSize="12sp"
            tools:text="0:51" />

        <SeekBar
            android:id="@+id/video_progress"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:max="1000"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:progressDrawable="@drawable/video_preview_seekbar"
            android:splitTrack="false"
            android:thumb="@drawable/video_preview_seekbar_thumb" />

        <TextView
            android:id="@+id/video_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_mono"
            android:textColor="@color/reaction_overlay_card_border"
            android:textSize="12sp"
            tools:text="1:31" />

        <ImageView
            android:id="@+id/video_volume"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_preview_volume" />

        <ImageView
            android:id="@+id/video_maximize"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_preview_maximize" />

    </LinearLayout>

</FrameLayout>
