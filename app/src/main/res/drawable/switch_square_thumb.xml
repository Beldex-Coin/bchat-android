<?xml version="1.0" encoding="utf-8"?>
<!-- Revamp_2026 toggle thumb: 14dp square, 4dp inset, grey off / green on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="22dp" android:height="22dp" android:gravity="center">
                <shape android:shape="rectangle">
                    <size android:width="14dp" android:height="14dp" />
                    <solid android:color="#00BC33" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="22dp" android:height="22dp" android:gravity="center">
                <shape android:shape="rectangle">
                    <size android:width="14dp" android:height="14dp" />
                    <solid android:color="@color/switch_square_thumb_off" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
