<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/giphy_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <LinearLayout
        android:id="@+id/giphy_panel"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:layout_gravity="bottom"
        android:background="@drawable/giphy_picker_sheet_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/open_sans_semi_bold"
                android:text="Send Gif"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/giphy_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/circle_touch_highlight_background"
                android:contentDescription="@string/cancel"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/incoming_message_divider_color" />

        <io.beldex.bchat.giph.ui.GiphyActivityToolbar
            android:id="@+id/giphy_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/page_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/incoming_message_divider_color" />

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/giphy_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/incoming_message_divider_color" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="10dp"
            android:theme="@style/Widget.Bchat.TabLayout"
            app:tabGravity="fill"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabBackground="@drawable/tab_background_selector"
            app:tabMinWidth="96dp"
            app:tabRippleColor="@color/cell_selected"
            app:tabSelectedTextColor="@color/button_green"
            app:tabTextColor="@color/timestamp_in" />

        <ImageView
            android:id="@+id/giphy_logo"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:background="@color/page_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/poweredby_giphy" />
    </LinearLayout>
</FrameLayout>
