<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/dateBreakTextView"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:minWidth="110dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="20dp"
        android:fontFamily="@font/roboto_mono"
        android:gravity="center"
        android:background="@drawable/date_chip_background"
        android:textColor="@color/chat_meta_text"
        android:textSize="@dimen/very_small_font_size"
        android:textStyle="bold"
        tools:text="@tools:sample/date/hhmm" />

    <ImageView
        android:id="@+id/iconImageView"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        app:tint="@color/text"
        tools:src="@drawable/ic_timer" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/roboto_mono"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/control_message_text"
        android:textSize="11sp"
        tools:text="@string/MessageRecord_you_disabled_disappearing_messages" />

    <androidx.cardview.widget.CardView
        android:id="@+id/receiverStatusIconCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/small_spacing"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="5dp"
        android:elevation="5dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/group_left_message_background"
        app:cardCornerRadius="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/receiverStatusIconLinearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="15dp"
            android:paddingEnd="13dp"
            android:paddingBottom="15dp">

            <ImageView
                android:id="@+id/receiverStatusIconImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="10dp"
                tools:src="@drawable/ic_disappear_timer" />

            <TextView
                android:id="@+id/receiverStatusIconTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/roboto_mono"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/text"
                android:textSize="@dimen/very_small_font_size"
                android:textStyle="bold"
                tools:text="@string/MessageRecord_you_disabled_disappearing_messages" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/senderStatusIconCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="@dimen/medium_spacing"
        android:elevation="5dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/sent_call_card_background"
        app:cardCornerRadius="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/senderStatusIconLinearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="15dp"
            android:paddingEnd="13dp"
            android:paddingBottom="15dp">

            <TextView
                android:id="@+id/senderStatusIconTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_mono"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/very_small_font_size"
                android:textStyle="bold"
                tools:text="@string/MessageRecord_you_disabled_disappearing_messages" />

            <ImageView
                android:id="@+id/senderStatusIconImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                tools:src="@drawable/ic_timer" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/receivedCallCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/receivedCallBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/call_message_bubble_background_received_end"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:background="@color/call_card_inner_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@color/reply_draft_card_background">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/receivedCallIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_call_card_phone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/receivedCallText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_mono"
                        android:maxLines="1"
                        android:textColor="@color/disappear_icon_color"
                        android:textSize="12sp"
                        tools:text="Call" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/receivedCallDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_mono"
                        android:maxLines="1"
                        android:text="@string/call_duration_static"
                        android:textColor="@color/chat_meta_text"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/received_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_mono"
                android:textColor="#737373"
                android:textSize="10sp"
                tools:text="12:28 PM" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialledCallCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/dialledCallBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/call_message_bubble_background_sent_end"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:background="@color/call_card_inner_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@color/reply_draft_card_background">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/dialledCallIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_call_card_phone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/dialledCallText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_mono"
                        android:maxLines="1"
                        android:textColor="@color/disappear_icon_color"
                        android:textSize="12sp"
                        tools:text="Call" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/dialledCallDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto_mono"
                        android:maxLines="1"
                        android:text="@string/call_duration_static"
                        android:textColor="@color/chat_meta_text"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_msg_tick_sent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dialled_message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_mono"
                    android:textColor="@color/chat_meta_text"
                    android:textSize="10sp"
                    tools:text="12:28 PM" />
            </LinearLayout>
    </LinearLayout>

</LinearLayout>
