<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Header: 50dp #0B0B0B / #F0F0F0 bar, back + "Message Detail" (Open Sans 16), 1dp bottom border. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:minHeight="50dp"
        android:background="@color/chat_header_background"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/message_details"
        app:titleTextAppearance="@style/TextAppearance.Bchat.RevampToolbarTitle"
        app:titleTextColor="@color/disappear_icon_color" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chat_header_border" />

    <!-- Detail card: 14dp from the edges, 22dp / 16dp padding, 12dp between rows. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/message_detail_card_background"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/sentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/message_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_semi_bold"
                android:text="@string/message_details_header__sent"
                android:textColor="@color/disappear_icon_color"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/sent_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/open_sans_semi_bold"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/chat_meta_text"
                android:textSize="14sp"
                tools:text="May 22 2024, 4:21:50 PM GMT +5.30" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expiresContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_semi_bold"
                android:text="@string/message_details_header__disappears"
                android:textColor="@color/disappear_icon_color"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/expires_in"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/open_sans_semi_bold"
                android:gravity="end"
                android:textColor="@color/chat_meta_text"
                android:textSize="14sp"
                tools:text="5 minutes" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_semi_bold"
                android:text="@string/message_details_header__error"
                android:textColor="@color/disappear_icon_color"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/open_sans_semi_bold"
                android:gravity="end"
                android:textColor="@color/chat_meta_text"
                android:textSize="14sp"
                tools:text="No network connection" />
        </LinearLayout>

        <!-- Resend: 148x52 corner-cut button (light in dark theme, black in white theme). -->
        <FrameLayout
            android:id="@+id/resend_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/resend_button"
                android:layout_width="148dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/message_detail_resend_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/roboto_mono"
                android:gravity="center"
                android:text="@string/message_recipients_list_item__resend"
                android:textColor="@color/chat_message_request_accept_text"
                android:textFontWeight="600"
                android:textSize="14sp"
                tools:targetApi="p" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
