<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preference_value_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:gravity="top"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/preference_value_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/open_sans_semi_bold"
        android:gravity="end"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:textColor="@color/setting_icon_tint"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/preference_value_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_expend"
        android:tint="@color/expend_icon_hint" />
</LinearLayout>